# -------------------------------------------------------------------------- #
#
# Quartus Prime project settings
#
# Project:
#     hft_nn
#
# Revision:
#     hft_nn_top
#
# Top-level entity:
#     hft_nn_top
#
# -------------------------------------------------------------------------- #


# =============================================================================
# Quartus metadata
# =============================================================================

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"


# =============================================================================
# Device
# =============================================================================



# =============================================================================
# Top-level entity
# =============================================================================



# =============================================================================
# VHDL configuration
# =============================================================================

set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF


# =============================================================================
# RTL source files
# =============================================================================

# Common NN types and fixed-point helper functions.
set_global_assignment -name VHDL_FILE ../../rtl/pkg/nn_types_pkg.vhd

# Quantized NN weights and biases.
set_global_assignment -name VHDL_FILE ../../rtl/pkg/nn_weights_pkg.vhd

# Reusable arithmetic blocks.
set_global_assignment -name VHDL_FILE ../../rtl/arithmetic/fixed_mul.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arithmetic/adder_tree_8.vhd

# Explicit neural-network arithmetic hierarchy.
set_global_assignment -name VHDL_FILE ../../rtl/nn/hidden_neuron.vhd
set_global_assignment -name VHDL_FILE ../../rtl/nn/output_neuron.vhd
set_global_assignment -name VHDL_FILE ../../rtl/nn/nn_core.vhd

# Board-level top entity.
set_global_assignment -name VHDL_FILE ../../rtl/top/hft_nn_top.vhd

# dense_hidden.vhd is deliberately excluded.
#
# The current implementation explicitly instantiates all eight hidden neurons
# inside nn_core to avoid the Quartus elaborator problem seen with the previous
# generate/generic hierarchy.
# set_global_assignment -name VHDL_FILE ../../rtl/nn/dense_hidden.vhd


# =============================================================================
# Timing constraints
# =============================================================================

set_global_assignment -name SDC_FILE hft_nn.sdc


# =============================================================================
# Simulation
# =============================================================================

set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation


# =============================================================================
# Partition
# =============================================================================

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


# =============================================================================
# Board-specific assignments
# =============================================================================

source ../constraints/c5g_hft_nn_assignments.qsf
set_global_assignment -name TOP_LEVEL_ENTITY hft_nn_top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH nn_core_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME nn_core_tb -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id nn_core_tb
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME nn_core_tb -section_id nn_core_tb
set_global_assignment -name EDA_TEST_BENCH_FILE ../../tb/nn_core_tb.vhd -section_id nn_core_tb
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top